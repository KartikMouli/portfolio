# Resend API key — https://resend.com/api-keys (use a "send-only" scoped key)
RESEND_API_KEY=

# Google Search Console verification — https://search.google.com/search-console
GOOGLE_VERIFICATION_CODE=

# Gemini API key for the portfolio chatbot — https://aistudio.google.com/apikey
# The variable name is fixed by @ai-sdk/google (read transparently). Don't rename.
GOOGLE_GENERATIVE_AI_API_KEY=
