# Resend API key — https://resend.com/api-keys (use a "send-only" scoped key)
RESEND_API_KEY=

# Google Search Console verification — https://search.google.com/search-console
GOOGLE_VERIFICATION_CODE=

# Gemini API key for the portfolio chatbot — https://aistudio.google.com/apikey
# The variable name is fixed by @ai-sdk/google (read transparently). Don't rename.
GOOGLE_GENERATIVE_AI_API_KEY=

# Dev-only — comma-separated LAN origins so you can test on a real phone
# over Wi-Fi at `http://<LAN_IP>:3000` without Next 16 blocking requests
# as cross-origin. Find your LAN IP via `hostname -I` (Linux) /
# `ipconfig getifaddr en0` (macOS).
# Example: NEXT_DEV_ALLOWED_ORIGINS=192.168.1.30,192.168.1.50
NEXT_DEV_ALLOWED_ORIGINS=
